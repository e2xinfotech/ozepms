# ---------------------------------------------------------------
# OzePMS environment settings. Copy to .env and fill in values.
# Never commit .env — it holds secrets.
# ---------------------------------------------------------------

APP_NAME=OzePMS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://ozepms.test
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# Defaults used when a new property is registered
OZ_DEFAULT_COUNTRY=IN
OZ_DEFAULT_CURRENCY=INR
OZ_DEFAULT_TIMEZONE=Asia/Kolkata
OZ_SUPPORT_EMAIL=support@e2xinfotech.in

# Security
HASH_DRIVER=argon2id
OZ_REQUIRE_2FA_PLATFORM=true
OZ_REQUIRE_2FA_OWNERS=true
OZ_SLOW_QUERY_MS=200
TRUSTED_PROXIES=127.0.0.1

# Optional single sign-on buttons on the login page
OZ_SSO_GOOGLE=false
OZ_SSO_MICROSOFT=false

# First Super Admin (used once by: php artisan db:seed)
OZ_ADMIN_NAME="E2X Super Admin"
OZ_ADMIN_EMAIL=admin@e2xinfotech.in
OZ_ADMIN_PASSWORD=

# Password of the accounts created by: php artisan db:seed --class=DemoSeeder (demo/staging only)
OZ_DEMO_PASSWORD=Demo@12345

# Logging
LOG_CHANNEL=oz
LOG_LEVEL=debug
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null

# Database (all application code uses this single connection)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ozepms
DB_USERNAME=ozepms
DB_PASSWORD=

# Sessions: "database" works out of the box; use "redis" in production
SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_COOKIE=oz_sid
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail ("log" writes e-mails to storage/logs for local testing)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@e2xinfotech.in"
MAIL_FROM_NAME="${APP_NAME}"

# Razorpay (Phase 4)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

VITE_APP_NAME="${APP_NAME}"
