# OzePMS container settings. bootstrap.sh copies this to app.env and fills the secrets.
# No quotes and no ${...} in this file (Docker reads it literally).
APP_NAME=OzePMS
APP_ENV=production
APP_DEBUG=false
APP_KEY=__APP_KEY__
APP_URL=https://__DOMAIN__
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

OZ_DEFAULT_COUNTRY=IN
OZ_DEFAULT_CURRENCY=INR
OZ_DEFAULT_TIMEZONE=Asia/Kolkata
OZ_SUPPORT_EMAIL=support@e2xinfotech.in

HASH_DRIVER=argon2id
OZ_REQUIRE_2FA_PLATFORM=true
OZ_REQUIRE_2FA_OWNERS=true
# Behind the shared proxy on the Docker network: trust its forwarded headers.
TRUSTED_PROXIES=*
OZ_BOOKING_DOMAIN=__BOOKING_DOMAIN__

OZ_SUPER_ADMIN_NAME=E2X Super Admin
OZ_SUPER_ADMIN_EMAIL=superadmin@e2xinfotech.in
OZ_SUPER_ADMIN_PASSWORD=
OZ_ADMIN_NAME=E2X Admin
OZ_ADMIN_EMAIL=admin@e2xinfotech.in
OZ_ADMIN_PASSWORD=

LOG_CHANNEL=oz
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=ozepms
DB_USERNAME=ozepms
DB_PASSWORD=__DB_PASSWORD__

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_COOKIE=oz_sid
SESSION_SAME_SITE=lax
SESSION_PATH=/
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# E-mail: fill in your SMTP account (invitations, password links and housekeeping mails need it).
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=null
MAIL_FROM_ADDRESS=no-reply@e2xinfotech.in
MAIL_FROM_NAME=OzePMS

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
OZ_NIGHT_AUDIT_TIME=02:00
OZ_INVOICE_ROUND_OFF=false
