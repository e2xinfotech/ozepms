# OzePMS queue worker — /etc/systemd/system/ozepms-queue.service
# Enable: sudo systemctl daemon-reload && sudo systemctl enable --now ozepms-queue
[Unit]
Description=OzePMS queue worker
After=network.target mysql.service redis-server.service

[Service]
User=ozepms
Group=www-data
WorkingDirectory=/var/www/ozepms/current
ExecStart=/usr/bin/php artisan queue:work --sleep=3 --tries=3 --backoff=10 --max-time=3600 --memory=256
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
